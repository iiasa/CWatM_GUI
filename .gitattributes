# Shell scripts must keep LF endings: a CRLF shebang makes bash fail with
# "bad interpreter: /usr/bin/env bash^M" on Linux, even though the file looks fine
# on Windows. gui.sh is checked out on both.
*.sh text eol=lf

# Windows launchers stay CRLF (cmd/wscript are happier with it).
*.bat text eol=crlf
*.vbs text eol=crlf
